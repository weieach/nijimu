# Copy to .env.local (gitignored) and fill in.
# No VITE_ prefix — these stay server-side and never reach the browser bundle.

# Speech-to-text for the recording screen (/api/transcribe)
OPENAI_API_KEY=
# Optional: override the transcription model (default gpt-4o-transcribe)
# TRANSCRIBE_MODEL=whisper-1

# Rewriting the transcript as prose on the transcript screen (/api/polish)
ANTHROPIC_API_KEY=
# Optional: override the polish model (default claude-opus-4-8)
# POLISH_MODEL=claude-haiku-4-5
